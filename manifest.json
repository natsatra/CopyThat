{
  "manifest_version": 3,
  "name": "CopyThat",
  "version": "1.0.0",
  "description": "A tabbed notepad for storing and copying text snippets. Organise your notes into colour-coded tabs, copy any tab's contents to the clipboard with one click, and paste wherever you need it.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "copythat@mathangi",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open CopyThat",
    "default_icon": {
      "16": "icon-16px.png",
      "48": "icon-48px.png"
    }
  },
  "icons": {

    "16": "icon-16px.png",  
    "48": "icon-48px.png",
    "128": "icon-128px.png"
  
  }
}